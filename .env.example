# Semantic Quote Search Engine — Environment Configuration

# Embedding model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval parameters
TOP_K=15
FINAL_RESULTS=3
MAX_QUERY_LENGTH=500

# Data paths (relative to project root)
QUOTES_PATH=data/quotes.json
FAISS_INDEX_PATH=data/quotes.index
METADATA_PATH=data/metadata.json

# Model loading
# DEVICE=cpu        # auto-detected if not set
# MODEL_DTYPE=float32

# Ollama LLM integration for dynamic debate essays
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen2.5:0.5b

# Budget optimizer
OPTIMIZER_MAX_TOKENS=1000
